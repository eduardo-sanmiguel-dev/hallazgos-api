{{#> layout}}
  <p style="margin: 0; font-size: 16px; line-height: 26px; color: #3d4b43;">
    <strong style="color: #13221a;">{{reassignedBy}}</strong> cambió los responsables de este
    hallazgo el {{reassignedAt}}.
  </p>

  {{> heading text="Responsables"}}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td class="stack stack-gap" width="46%" valign="top">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f8f3" style="background-color: #f5f8f3; border: 1px solid #e6ece4; border-radius: 14px;">
          <tr>
            <td style="padding: 14px 16px;">
              <p style="margin: 0; font-size: 10px; line-height: 14px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #6b7a71;">Antes</p>
              <p style="margin: 6px 0 0 0; font-size: 15px; line-height: 22px; color: #6b7a71; text-decoration: line-through;">{{previousResponsibles}}</p>
            </td>
          </tr>
        </table>
      </td>
      <td class="stack stack-gap" width="8%" align="center" valign="middle" style="font-size: 22px; line-height: 22px; font-weight: 700; color: {{theme.accent}};">&rarr;</td>
      <td class="stack" width="46%" valign="top">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f8f3" style="background-color: #f5f8f3; border: 2px solid {{theme.accent}}; border-radius: 14px;">
          <tr>
            <td style="padding: 14px 16px;">
              <p style="margin: 0; font-size: 10px; line-height: 14px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: {{theme.accent}};">Ahora</p>
              <p style="margin: 6px 0 0 0; font-size: 15px; line-height: 22px; font-weight: 700; color: #13221a;">{{currentResponsibles}}</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  {{> tiles}}
  {{> cta}}
  {{#if descripcion}}
    {{> heading text="Lo que se observó"}}
    {{> quote text=descripcion color=theme.accent}}
  {{/if}}
  {{#if photoPair}}
    {{> heading text=photoPair.heading}}
    {{> photo-pair photoPair}}
  {{else}}
    {{#if photo}}
      {{> heading text=photo.heading}}
      {{> photo photo}}
    {{/if}}
  {{/if}}
  {{> steps}}
  {{> details}}
{{/layout}}
