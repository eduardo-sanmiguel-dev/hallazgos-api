{{#> layout}}
  <p style="margin: 0; font-size: 16px; line-height: 26px; color: #374151;">
    <strong style="color: #111827;">{{startedBy}}</strong> comenzó a atender este hallazgo.
    Te avisamos porque tú lo reportaste.
  </p>
  {{> tiles}}
  {{> cta}}
  {{#if descripcion}}
    {{> heading text="Lo que se observó"}}
    {{> quote text=descripcion color=theme.accent}}
  {{/if}}
  {{#if photoPair}}
    {{> heading text=photoPair.heading}}
    {{> photo-pair photoPair}}
  {{else}}
    {{#if photo}}
      {{> heading text=photo.heading}}
      {{> photo photo}}
    {{/if}}
  {{/if}}
  {{> steps}}
  {{> details}}
{{/layout}}
