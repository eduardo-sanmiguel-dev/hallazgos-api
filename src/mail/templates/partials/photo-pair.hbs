{{! Dos fotos lado a lado (antes / después); en celular se apilan. }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="stack stack-gap" width="50%" valign="top" style="padding: 0 6px 0 0;">
      <p style="margin: 0 0 8px 0; font-size: 12px; line-height: 17px; font-weight: 700; color: #374151;">
        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: {{leftColor}}; margin-right: 6px;"></span>{{leftCaption}}
      </p>
      <img src="cid:{{leftCid}}" width="257" alt="{{leftCaption}}" class="fluid" style="display: block; width: 100%; max-width: 257px; height: auto; border: 0; border-radius: 14px;" />
    </td>
    <td class="stack" width="50%" valign="top" style="padding: 0 0 0 6px;">
      <p style="margin: 0 0 8px 0; font-size: 12px; line-height: 17px; font-weight: 700; color: #374151;">
        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: {{rightColor}}; margin-right: 6px;"></span>{{rightCaption}}
      </p>
      <img src="cid:{{rightCid}}" width="257" alt="{{rightCaption}}" class="fluid" style="display: block; width: 100%; max-width: 257px; height: auto; border: 0; border-radius: 14px;" />
    </td>
  </tr>
</table>
