{{! Fila de indicadores (en celular se apilan). Cada uno trae su ancho. }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 24px;">
  <tr>
    {{#each tiles}}
      {{#if @first}}
        {{> tile label=label t=this width=width pad="0 6px 0 0"}}
      {{else}}
        {{#if @last}}
          {{> tile label=label t=this width=width pad="0 0 0 6px"}}
        {{else}}
          {{> tile label=label t=this width=width pad="0 3px"}}
        {{/if}}
      {{/if}}
    {{/each}}
  </tr>
</table>
