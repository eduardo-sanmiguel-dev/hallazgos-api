{{! Detalles en dos columnas; una fila sin pareja deja la derecha vacía. }}
{{> heading text="Detalles"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  {{#each details}}
    <tr>
      <td width="50%" valign="top" style="padding: 12px 12px 12px 0; border-top: 1px solid #e5e7eb;">
        <p style="margin: 0; font-size: 11px; line-height: 16px; color: #6b7280;">{{left.label}}</p>
        <p style="margin: 2px 0 0 0; font-size: 14px; line-height: 20px; font-weight: 600; color: #111827;">{{left.value}}</p>
      </td>
      <td width="50%" valign="top" style="padding: 12px 0; border-top: 1px solid #e5e7eb;">
        {{#if right}}
          <p style="margin: 0; font-size: 11px; line-height: 16px; color: #6b7280;">{{right.label}}</p>
          <p style="margin: 2px 0 0 0; font-size: 14px; line-height: 20px; font-weight: 600; color: #111827;">{{right.value}}</p>
        {{/if}}
      </td>
    </tr>
  {{/each}}
</table>
