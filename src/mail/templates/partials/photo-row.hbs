{{! Fotos lado a lado (antes, avance, después); en celular se apilan. Cada
    una trae su ancho (mail.view.ts, photosView). }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    {{#each items}}
      <td class="stack stack-gap" width="{{width}}" valign="top" style="padding: {{pad}};">
        <p style="margin: 0 0 8px 0; font-size: 12px; line-height: 17px; font-weight: 700; color: #374151;">
          <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: {{color}}; margin-right: 6px;"></span>{{caption}}
        </p>
        <img src="cid:{{cid}}" width="{{imgWidth}}" alt="{{caption}}" class="fluid" style="display: block; width: 100%; max-width: {{imgWidth}}px; height: auto; border: 0; border-radius: 14px;" />
      </td>
    {{/each}}
  </tr>
</table>
