{{! Una sola foto, centrada y de ancho medio: una vertical a todo lo ancho
    ocuparía la pantalla entera. En celular, a todo lo ancho. }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td align="center">
      <img src="cid:{{cid}}" width="340" alt="{{alt}}" class="fluid" style="display: block; width: 100%; max-width: 340px; height: auto; border: 0; border-radius: 14px;" />
      <p style="margin: 8px 0 0 0; font-size: 12px; line-height: 17px; color: #6b7a71; text-align: center;">{{caption}}</p>
    </td>
  </tr>
</table>
