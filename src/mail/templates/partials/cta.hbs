{{! Botón "Ver hallazgo": abre su detalle en ComportArte (sin sesión, el
    login regresa a él). Celda con color de fondo: funciona en Outlook. }}
{{#if viewUrl}}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top: 22px;">
    <tr>
      <td bgcolor="#3e6925" style="background-color: #3e6925; border-radius: 12px;">
        <a href="{{viewUrl}}" style="display: inline-block; padding: 14px 26px; font-size: 15px; line-height: 20px; font-weight: 700; color: #ffffff; text-decoration: none; border-radius: 12px;">Ver hallazgo en ComportArte &rarr;</a>
      </td>
    </tr>
  </table>
{{/if}}
