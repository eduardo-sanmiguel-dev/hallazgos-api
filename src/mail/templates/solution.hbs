{{#> layout}}
  <p style="margin: 0; font-size: 16px; line-height: 26px; color: #374151;">
    {{#if closedBy}}
      <strong style="color: #111827;">{{closedBy}}</strong> dio por solucionado este hallazgo.
    {{else}}
      Este hallazgo quedó solucionado.
    {{/if}}
    Gracias por ayudar a mantener un lugar de trabajo seguro.
  </p>
  {{> tiles}}
  {{> cta}}
  {{#if descripcionSolucion}}
    {{> heading text="Cómo se resolvió"}}
    {{> quote text=descripcionSolucion color=theme.accent}}
  {{/if}}
  {{#if descripcion}}
    {{> heading text="Lo que se observó"}}
    {{> quote text=descripcion color="#b45309"}}
  {{/if}}
  {{#if photoPair}}
    {{> heading text=photoPair.heading}}
    {{> photo-pair photoPair}}
  {{else}}
    {{#if photo}}
      {{> heading text=photo.heading}}
      {{> photo photo}}
    {{/if}}
  {{/if}}
  {{> steps}}
  {{> details}}
{{/layout}}
