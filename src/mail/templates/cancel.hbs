{{#> layout}}
  <p style="margin: 0; font-size: 16px; line-height: 26px; color: #374151;">
    <strong style="color: #111827;">{{cancelledByName}}</strong> canceló este hallazgo.
    Ya no requiere seguimiento.
  </p>
  {{> tiles}}
  {{> cta}}
  {{#if descripcion}}
    {{> heading text="Lo que se observó"}}
    {{> quote text=descripcion color=theme.accent}}
  {{/if}}
  {{#if photoRow}}
    {{> heading text=photoRow.heading}}
    {{> photo-row photoRow}}
  {{else}}
    {{#if photo}}
      {{> heading text=photo.heading}}
      {{> photo photo}}
    {{/if}}
  {{/if}}
  {{> steps}}
  {{> details}}
{{/layout}}
