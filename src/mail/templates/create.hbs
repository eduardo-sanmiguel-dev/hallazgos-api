{{#> layout}}
  <p style="margin: 0; font-size: 16px; line-height: 26px; color: #3d4b43;">
    Se registró un nuevo hallazgo en <strong style="color: #13221a;">{{manufacturingPlant}}</strong>
    que requiere atención. Lo reportó <strong style="color: #13221a;">{{userWhoCreated}}</strong>.
  </p>
  {{> tiles}}
  {{> cta}}
  {{#if descripcion}}
    {{> heading text="Lo que se observó"}}
    {{> quote text=descripcion color=theme.accent}}
  {{/if}}
  {{#if photoPair}}
    {{> heading text=photoPair.heading}}
    {{> photo-pair photoPair}}
  {{else}}
    {{#if photo}}
      {{> heading text=photo.heading}}
      {{> photo photo}}
    {{/if}}
  {{/if}}
  {{> steps}}
  {{> details}}
{{/layout}}
