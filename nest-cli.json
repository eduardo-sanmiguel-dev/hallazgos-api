{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": ["mail/templates/**/*", "**/*.worker.mjs"],
    "watchAssets": true,
    "builder": {
      "type": "swc",
      "options": { "swcrcPath": ".swcrc" }
    },
    "typeCheck": false
  }
}
