{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=production nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --config nest-cli.dev.json --watch --no-shell",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.json --incremental false",
    "typecheck:ts6": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.build.json",
    "start:debug": "cross-env NODE_ENV=development nest start --config nest-cli.dev.json --debug --watch --no-shell",
    "start:prod": "node --import ./dist/instrumentation.js dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "fix:epp-delivery-date": "node scripts/epp-delivery-date/run.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:cov:goal": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage && node scripts/coverage-goal.js",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:db": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-db.json --forceExit",
    "test:db:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-db.json --forceExit --coverage",
    "migration:run": "node --import ./scripts/register-ts.js ./node_modules/typeorm/cli.js -d src/config/typeorm.config.ts migration:run",
    "migration:revert": "node --import ./scripts/register-ts.js ./node_modules/typeorm/cli.js -d src/config/typeorm.config.ts migration:revert",
    "migration:run:prod": "cross-env NODE_ENV=production node --import ./scripts/register-ts.js ./node_modules/typeorm/cli.js -d src/config/typeorm.config.ts migration:run",
    "migration:revert:prod": "cross-env NODE_ENV=production node --import ./scripts/register-ts.js ./node_modules/typeorm/cli.js -d src/config/typeorm.config.ts migration:revert",
    "seed:dev": "cross-env NODE_ENV=development node --import ./scripts/register-ts.js ./node_modules/typeorm-extension/bin/cli.cjs seed:run -d src/config/typeorm.config.ts",
    "seed:prod": "cross-env NODE_ENV=production node --import ./scripts/register-ts.js ./node_modules/typeorm-extension/bin/cli.cjs seed:run -d src/config/typeorm.config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs-modules/mailer": "^3.0.2",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-graphql": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "graphql": "^16.9.0",
    "handlebars": "^4.7.10",
    "helmet": "8.3.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.0",
    "nodemailer": "^10.1.7",
    "pdfmake": "^0.3.12",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "typeorm-extension": "^3.6.2",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
