{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "modulePaths": [
    "<rootDir>/../src"
  ],
  "moduleNameMapper": {
    "^@config$": "<rootDir>/../src/config",
    "^@shared/(.*)$": "<rootDir>/../src/shared/$1"
  }
}
