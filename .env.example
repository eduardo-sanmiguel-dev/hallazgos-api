# Copiar a .env.development (o .env.production en el servidor) y completar.
# Joi valida estas variables al arrancar: si falta una obligatoria, la API no
# inicia. NODE_ENV lo fijan los scripts (start:dev, start, PM2).

### APP ###
PORT=4000
# Debe coincidir con VITE_APP_KEY de la UI (cabecera x-app-key).
APP_KEY=123
# URL pública de la UI: enlaces de los correos.
FRONTEND_URL=http://localhost:3000

### CORS ###
# Orígenes permitidos, separados por coma. Usar localhost: 127.0.0.1 es otro origen.
WHITE_LIST_DOMAINS=http://localhost:3000,http://localhost:3001

### JWT ###
JWT_SECRET_KEY=123

### DB ###
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=12345
DB_NAME=hallazgos_db_dev
DB_PORT=5432
# Pool de la API (opcionales): máximo, mínimo abiertas y cierre por inactividad en ms.
# DB_POOL_MAX=10
# DB_POOL_MIN=2
# DB_POOL_IDLE_MS=300000

### MAIL ###
MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
MAIL_USER=example@gmail.com
# Contraseña de aplicación del SMTP (no puede quedar vacía).
MAIL_PASSWORD=cambiar-por-la-contraseña
# Correos persistentes (outbox). Obligatoria en producción: clave fuerte e
# independiente de al menos 32 caracteres (p. ej. `openssl rand -base64 48`).
# No cambiarla: cifra los correos en cola. En desarrollo es opcional.
# MAIL_OUTBOX_KEY=
MAIL_REDIS_URL=redis://127.0.0.1:6381
MAIL_OUTBOX_DIR=var/mail-outbox/blobs

### SEGURIDAD ###
# Interruptor remoto: en producción se comprueba al arrancar y cada hora; si no
# coincide, la API se detiene. En desarrollo no se consulta.
GIST_SECRET_URL=https://gist.githubusercontent.com/usuario/id/raw/secreto.txt

### OPENOBSERVE (solo producción) ###
# Logs en el stream OBSERVE_STREAM y trazas de HTTP y PostgreSQL.
OBSERVE_ENDPOINT=http://0.0.0.0:5080/api/default
OBSERVE_AUTH_HEADER="Basic <base64 de usuario:contraseña>"
OBSERVE_STREAM=api_comportarte

### VERSIONES DE DESPLIEGUE (opcionales) ###
# Por defecto: ~/.local/state/hallazgos/ui-version.json y, en producción,
# dist/deployment-version.json.
# UI_VERSION_FILE=
# API_VERSION_FILE=

### PRUEBAS E2E DE LA UI (solo desarrollo con base local) ###
# Al levantar la API se crea este usuario si no existe. Mismos valores que
# hallazgos-ui/e2e/.env.e2e.
# E2E_EMAIL=e2e@hallazgos.test
# E2E_PASSWORD=
