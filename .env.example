### APP ###
PORT=4000
APP_KEY=123
FRONTEND_URL=http://localhost:3000

### CORS ###
WHITE_LIST_DOMAINS=http://localhost:3000,http://localhost:3001

### JWT ###
JWT_SECRET_KEY=123

### DB ###
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=12345
DB_NAME=hallazgos_db_dev
DB_PORT=5432
# Pool de la API (opcionales): máximo, mínimo abiertas y cierre por inactividad en ms.
# DB_POOL_MAX=10
# DB_POOL_MIN=2
# DB_POOL_IDLE_MS=300000

# MAIL
MAIL_HOST=smtp.gmail.com
MAIL_USER=example@gmail.com
MAIL_PASSWORD=""

# OpenObserve (solo producción): logs de la API en el stream OBSERVE_STREAM.
OBSERVE_ENDPOINT=http://0.0.0.0:5080/api/default
OBSERVE_AUTH_HEADER="Basic <base64 de usuario:contraseña>"
OBSERVE_STREAM=api_comportarte

# Usuario de pruebas e2e del UI (solo desarrollo con base local): al levantar
# la API se crea si no existe. Mismos valores que hallazgos-ui/e2e/.env.e2e.
E2E_EMAIL=e2e@hallazgos.test
E2E_PASSWORD=

# Persistent mail: generate a strong independent key and keep it across restarts/backups.
MAIL_OUTBOX_KEY=
MAIL_REDIS_URL=redis://127.0.0.1:6381
MAIL_OUTBOX_DIR=var/mail-outbox/blobs
